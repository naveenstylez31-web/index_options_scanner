TELEGRAM_BOT_TOKEN=8633697052
# Public channel: @yourchannel   |   Private channel: -100xxxxxxxxxx
TELEGRAM_CHAT_ID=8663196728

# ---------- Optional: Claude-written desk note in the 08:30 brief ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------- Optional: your own GIFT Nifty JSON quote URL ----------
GIFT_NIFTY_URL=

# ---------- Schedule (IST) ----------
TOKEN_REFRESH_TIME=08:10
PREMARKET_TIME=08:30
OPENING_CHECK_TIME=09:25
MONITOR_START=09:17
MONITOR_END=15:30
MONITOR_INTERVAL_MIN=3
EOD_TIME=15:40

# ---------- Intraday alert sensitivity ----------
STRIKES_WINDOW=10          # strikes either side of ATM to watch
PCR_SHIFT_ALERT=0.10       # alert when PCR moves this much from last alert
STRIKE_OI_SURGE_PCT=25     # % OI change at a strike in 15 min
STRIKE_OI_MIN_LAKH=10      # ...and at least this many lakh units
IV_SPIKE_PTS=1.5           # ATM IV change (vol points) in 15 min
ALERT_COOLDOWN_MIN=15      # do not repeat the same alert within N minutes
HOURLY_DIGEST=true

# Dhan security IDs of the indices (IDX_I segment). Change only if Dhan's instrument list differs.
NIFTY_SECURITY_ID=13
SENSEX_SECURITY_ID=51
